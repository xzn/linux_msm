From bc93e8fa8e6871828e8b29ca44ba45e011f7e0f4 Mon Sep 17 00:00:00 2001
From: JS Deck <jsdeckerido@gmail.com>
Date: Wed, 21 Oct 2026 19:05:15 -0300
Subject: [PATCH 604/604] drm/msm/dp: return error and turn off link stream if
 training error

---
 drivers/gpu/drm/msm/dp/dp_ctrl.c    | 24 +++++++++++++++++++++---
 drivers/gpu/drm/msm/dp/dp_display.c | 12 +++++++++---
 2 files changed, 30 insertions(+), 6 deletions(-)

diff --git a/drivers/gpu/drm/msm/dp/dp_ctrl.c b/drivers/gpu/drm/msm/dp/dp_ctrl.c
index f0a9a602433e..bd1c33884740 100644
--- a/drivers/gpu/drm/msm/dp/dp_ctrl.c
+++ b/drivers/gpu/drm/msm/dp/dp_ctrl.c
@@ -1134,6 +1134,11 @@ static void msm_dp_ctrl_link_clk_disable(struct msm_dp_ctrl *msm_dp_ctrl)
 
 	ctrl = container_of(msm_dp_ctrl, struct msm_dp_ctrl_private, msm_dp_ctrl);
 
+	if (!ctrl->link_clks_on) {
+		drm_dbg_dp(ctrl->drm_dev, "links clks already disabled\n");
+		return;
+	}
+
 	clk_bulk_disable_unprepare(ctrl->num_link_clks, ctrl->link_clks);
 
 	ctrl->link_clks_on = false;
@@ -2005,8 +2010,11 @@ int msm_dp_ctrl_on_stream(struct msm_dp_ctrl *msm_dp_ctrl, bool force_link_train
 		ctrl->stream_clks_on = true;
 	}
 
-	if (force_link_train || !msm_dp_ctrl_channel_eq_ok(ctrl))
-		msm_dp_ctrl_link_retrain(ctrl);
+	if (force_link_train || !msm_dp_ctrl_channel_eq_ok(ctrl)) {
+		ret = msm_dp_ctrl_link_retrain(ctrl);
+		if (ret)
+			goto end;
+	}
 
 	/* stop txing train pattern to end link training */
 	msm_dp_ctrl_clear_training_pattern(ctrl, DP_PHY_DPRX);
@@ -2041,7 +2049,7 @@ int msm_dp_ctrl_on_stream(struct msm_dp_ctrl *msm_dp_ctrl, bool force_link_train
 
 	ret = msm_dp_ctrl_wait4video_ready(ctrl);
 	if (ret)
-		return ret;
+		goto end;
 
 	mainlink_ready = msm_dp_ctrl_mainlink_ready(ctrl);
 	drm_dbg_dp(ctrl->drm_dev,
@@ -2054,6 +2062,9 @@ int msm_dp_ctrl_on_stream(struct msm_dp_ctrl *msm_dp_ctrl, bool force_link_train
 		msm_dp_ctrl_sink_dsc_enable(ctrl);
 
 end:
+	if (ret)
+		msm_dp_ctrl_off_link_stream(msm_dp_ctrl);
+
 	return ret;
 }
 
@@ -2067,6 +2078,13 @@ void msm_dp_ctrl_off_link_stream(struct msm_dp_ctrl *msm_dp_ctrl)
 
 	msm_dp_panel_disable_vsc_sdp(ctrl->panel);
 
+	if (ctrl->panel->fec_cap.supported)
+		msm_dp_ctrl_host_fec_stop(ctrl);
+	if (ctrl->panel->dsc_cap.supported) {
+		msm_dp_ctrl_config_dsc_dto(ctrl, false);
+		msm_dp_panel_override_ack_dto(ctrl->panel, false);
+	}
+
 	/* set dongle to D3 (power off) mode */
 	msm_dp_link_psm_config(ctrl->link, &ctrl->panel->link_info, true);
 
diff --git a/drivers/gpu/drm/msm/dp/dp_display.c b/drivers/gpu/drm/msm/dp/dp_display.c
index f3270d4b01dc..17ee40571985 100644
--- a/drivers/gpu/drm/msm/dp/dp_display.c
+++ b/drivers/gpu/drm/msm/dp/dp_display.c
@@ -498,13 +498,14 @@ static int msm_dp_hpd_unplug_handle_guarded(struct msm_dp_display_private *dp)
 	if (!dp->msm_dp_display.is_edp)
 		msm_dp_panel_unplugged(dp->panel, dp->msm_dp_display.connector);
 
-	if (!dp->msm_dp_display.power_on)
+	if (!dp->msm_dp_display.power_on) {
 		/* triggered by irq_hdp with sink_count = 0 */
+		msm_dp_ctrl_off(dp->ctrl);
 		msm_dp_display_host_phy_exit(dp);
 
 		/* do not call msm_dp_display_pmic_glink_notify (will deadlock).
 		 * pmic_glink_altmode_port_work will be called in pmic_glink_altmode after this. */
-	else
+	} else
 		/* delay reconnect for next plug_handle until display_disable to avoid race */
 		dp->plugged_pending = PLUGGED_PENDING_DISCONNECT;
 
@@ -1612,7 +1613,12 @@ void msm_dp_bridge_atomic_enable(struct drm_bridge *drm_bridge,
 		return;
 
 	if (dp->is_edp)
-		msm_dp_hpd_plug_handle_guarded(msm_dp_display);
+		rc = msm_dp_hpd_plug_handle_guarded(msm_dp_display);
+	else
+		rc = msm_dp_link_psm_config(msm_dp_display->link, &msm_dp_display->panel->link_info, false);
+
+	if (rc)
+		goto end;
 
 	if (msm_dp_display->plugged < PLUGGED_STATE_LINK_READY)
 		return;
-- 
2.55.0

