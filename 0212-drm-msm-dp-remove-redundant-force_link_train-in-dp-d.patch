From 7b566d9639c514cac5aef9c629299eb647a688f4 Mon Sep 17 00:00:00 2001
From: JS Deck <jsdeckerido@gmail.com>
Date: Mon, 5 Oct 2026 12:32:05 -0300
Subject: [PATCH 212/219] drm/msm/dp: remove redundant force_link_train in dp
 display atomic_enable

Refactor from 5043357 makes force_link_train always true due to the power_on
condition. Remove redundant check.

6fe5a25 also makes link train happen in atomic_enable right before
display_enable already, so set force_link_train to false always.
---
 drivers/gpu/drm/msm/dp/dp_display.c | 12 ++++--------
 1 file changed, 4 insertions(+), 8 deletions(-)

diff --git a/drivers/gpu/drm/msm/dp/dp_display.c b/drivers/gpu/drm/msm/dp/dp_display.c
index fdeef52fd2ab..061a36934bd7 100644
--- a/drivers/gpu/drm/msm/dp/dp_display.c
+++ b/drivers/gpu/drm/msm/dp/dp_display.c
@@ -603,7 +603,7 @@ static int msm_dp_display_set_mode(struct msm_dp *msm_dp_display,
 	return 0;
 }
 
-static int msm_dp_display_enable(struct msm_dp_display_private *dp, bool force_link_train)
+static int msm_dp_display_enable(struct msm_dp_display_private *dp)
 {
 	int rc = 0;
 	struct msm_dp *msm_dp_display = &dp->msm_dp_display;
@@ -614,7 +614,7 @@ static int msm_dp_display_enable(struct msm_dp_display_private *dp, bool force_l
 		return 0;
 	}
 
-	rc = msm_dp_ctrl_on_stream(dp->ctrl, force_link_train);
+	rc = msm_dp_ctrl_on_stream(dp->ctrl, false);
 	if (!rc)
 		msm_dp_display->power_on = true;
 
@@ -1297,7 +1297,6 @@ void msm_dp_bridge_atomic_enable(struct drm_bridge *drm_bridge,
 	struct msm_dp *dp = msm_dp_bridge->msm_dp_display;
 	int rc = 0;
 	struct msm_dp_display_private *msm_dp_display;
-	bool force_link_train = false;
 
 	msm_dp_display = container_of(dp, struct msm_dp_display_private, msm_dp_display);
 	if (!msm_dp_display->msm_dp_mode.drm_mode.clock) {
@@ -1322,10 +1321,7 @@ void msm_dp_bridge_atomic_enable(struct drm_bridge *drm_bridge,
 		return;
 	}
 
-	if (!dp->power_on) {
-		msm_dp_display_host_phy_init(msm_dp_display);
-		force_link_train = true;
-	}
+	msm_dp_display_host_phy_init(msm_dp_display);
 
 	rc = msm_dp_ctrl_on_link(msm_dp_display->ctrl);
 	if (rc) {
@@ -1334,7 +1330,7 @@ void msm_dp_bridge_atomic_enable(struct drm_bridge *drm_bridge,
 		return;
 	}
 
-	msm_dp_display_enable(msm_dp_display, force_link_train);
+	msm_dp_display_enable(msm_dp_display);
 
 	rc = msm_dp_display_post_enable(dp);
 	if (rc) {
-- 
