From bc51aabb8bfb0c7a3c1abed5fadc678ac9129a5f Mon Sep 17 00:00:00 2001
From: JS Deck <jsdeckerido@gmail.com>
Date: Mon, 5 Oct 2026 16:33:43 -0300
Subject: [PATCH 216/219] drm/msm/dp: rework dp display state machines
 represented by bools into enums

This should help make code easier to read and maintain.
The state machine is similar to the one before 5043357, but has two enums
instead of one, to not logically conflate them.
---
 drivers/gpu/drm/msm/dp/dp_display.c | 79 ++++++++++++++++++-----------
 1 file changed, 50 insertions(+), 29 deletions(-)

diff --git a/drivers/gpu/drm/msm/dp/dp_display.c b/drivers/gpu/drm/msm/dp/dp_display.c
index fdd94eeb208b..1f85bdd1baea 100644
--- a/drivers/gpu/drm/msm/dp/dp_display.c
+++ b/drivers/gpu/drm/msm/dp/dp_display.c
@@ -43,6 +43,18 @@ enum {
 	ISR_HPD_REPLUG_COUNT,
 };
 
+enum plugged_state {
+	PLUGGED_STATE_NOT_READY,
+	PLUGGED_STATE_PHY_READY,
+	PLUGGED_STATE_LINK_READY,
+};
+
+enum plugged_pending {
+	PLUGGED_PENDING_NONE,
+	PLUGGED_PENDING_DISCONNECT,
+	PLUGGED_PENDING_CONNECT,
+};
+
 struct msm_dp_display_private {
 	int irq;
 
@@ -54,10 +66,8 @@ struct msm_dp_display_private {
 	bool audio_supported;
 
 	struct mutex plugged_lock;
-	bool plugged;
-	bool plugged_connected;
-	bool plugged_disconnecting;
-	bool plugged_reconnecting;
+	enum plugged_state plugged;
+	enum plugged_pending plugged_pending;
 	struct work_struct plugged_retry_work;
 
 	struct drm_device *drm_dev;
@@ -400,10 +410,10 @@ static int msm_dp_hpd_plug_handle_guarded(struct msm_dp_display_private *dp)
 			dp->msm_dp_display.connector_type,
 			dp->link->sink_count);
 
-	if (dp->plugged_connected)
+	if (dp->plugged >= PLUGGED_STATE_LINK_READY)
 		return 0;
 
-	if (!dp->plugged) {
+	if (dp->plugged < PLUGGED_STATE_PHY_READY) {
 		ret = pm_runtime_resume_and_get(&pdev->dev);
 		if (ret) {
 			DRM_ERROR("failed to pm_runtime_resume\n");
@@ -414,13 +424,12 @@ static int msm_dp_hpd_plug_handle_guarded(struct msm_dp_display_private *dp)
 
 		msm_dp_display_host_phy_init(dp);
 
-		dp->plugged = true;
+		dp->plugged = PLUGGED_STATE_PHY_READY;
 	}
 
 	/* Retry from display_disable */
-	if (dp->plugged_disconnecting || dp->plugged_reconnecting) {
-		dp->plugged_disconnecting = false;
-		dp->plugged_reconnecting = true;
+	if (dp->plugged_pending > PLUGGED_PENDING_NONE) {
+		dp->plugged_pending = PLUGGED_PENDING_CONNECT;
 		return 0;
 	}
 
@@ -443,7 +452,10 @@ static int msm_dp_hpd_plug_handle_guarded(struct msm_dp_display_private *dp)
 			dp->link->sink_count);
 
 end:
-	dp->plugged_connected = !ret;
+	if (!ret)
+		dp->plugged = PLUGGED_STATE_LINK_READY;
+	else
+		dp->plugged = PLUGGED_STATE_PHY_READY;
 
 	return ret;
 }
@@ -474,21 +486,19 @@ static int msm_dp_hpd_unplug_handle_guarded(struct msm_dp_display_private *dp)
 			dp->msm_dp_display.connector_type,
 			dp->link->sink_count);
 
-	if (!dp->plugged)
+	if (dp->plugged < PLUGGED_STATE_PHY_READY)
 		return 0;
 
 	/* Don't forget modes for eDP */
 	if (!dp->msm_dp_display.is_edp)
 		msm_dp_panel_unplugged(dp->panel, dp->msm_dp_display.connector);
 
-	if (!dp->msm_dp_display.power_on) {
+	if (!dp->msm_dp_display.power_on)
 		/* triggered by irq_hdp with sink_count = 0 */
 		msm_dp_display_host_phy_exit(dp);
-	} else {
+	else
 		/* delay reconnect for next plug_handle until display_disable to avoid race */
-		dp->plugged_disconnecting = true;
-		dp->plugged_reconnecting = false;
-	}
+		dp->plugged_pending = PLUGGED_PENDING_DISCONNECT;
 
 	/*
 	 * We don't need separate work for disconnect as
@@ -507,12 +517,9 @@ static int msm_dp_hpd_unplug_handle_guarded(struct msm_dp_display_private *dp)
 			dp->msm_dp_display.connector_type,
 			dp->link->sink_count);
 
-	if (dp->plugged) {
-		pm_runtime_put_sync(&pdev->dev);
-		dp->plugged = false;
-	}
+	pm_runtime_put_sync(&pdev->dev);
 
-	dp->plugged_connected = false;
+	dp->plugged = PLUGGED_STATE_NOT_READY;
 
 	return 0;
 }
@@ -527,6 +534,9 @@ static int msm_dp_irq_hpd_handle_guarded(struct msm_dp_display_private *dp)
 			dp->msm_dp_display.connector_type,
 			dp->link->sink_count);
 
+	if (dp->plugged < PLUGGED_STATE_PHY_READY)
+		return -EINVAL;
+
 	rc = msm_dp_link_psm_config(dp->link, &dp->panel->link_info, false);
 	if (rc)
 		goto end;
@@ -547,7 +557,10 @@ static int msm_dp_irq_hpd_handle_guarded(struct msm_dp_display_private *dp)
 			dp->link->sink_count);
 
 end:
-	dp->plugged_connected = !rc;
+	if (!rc)
+		dp->plugged = PLUGGED_STATE_LINK_READY;
+	else
+		dp->plugged = PLUGGED_STATE_PHY_READY;
 
 	return rc;
 }
@@ -717,9 +730,9 @@ static int msm_dp_display_disable(struct msm_dp_display_private *dp)
 
 	msm_dp_display->power_on = false;
 
-	dp->plugged_disconnecting = false;
-	if (dp->plugged_reconnecting) {
-		dp->plugged_reconnecting = false;
+	if (dp->plugged_pending == PLUGGED_PENDING_CONNECT) {
+		/* reset before calling plug_handle */
+		dp->plugged_pending = PLUGGED_PENDING_NONE;
 
 		/* call plug_handle explicitly instead of relying on bridge_detect */
 		msm_dp_hpd_plug_handle_guarded(dp);
@@ -727,6 +740,9 @@ static int msm_dp_display_disable(struct msm_dp_display_private *dp)
 		schedule_work(&dp->plugged_retry_work);
 	}
 
+	/* also reset for all other cases */
+	dp->plugged_pending = PLUGGED_PENDING_NONE;
+
 	drm_dbg_dp(dp->drm_dev, "sink count: %d\n", dp->link->sink_count);
 	return 0;
 }
@@ -896,7 +912,7 @@ enum drm_connector_status msm_dp_bridge_detect(struct drm_bridge *bridge,
 	guard(mutex)(&priv->plugged_lock);
 
 	/* Retry for plug_handle fail, or for plugged_retry_work_fn. */
-	if (priv->plugged && !priv->plugged_connected) {
+	if (priv->plugged == PLUGGED_STATE_PHY_READY) {
 		rc = msm_dp_hpd_plug_handle_guarded(priv);
 		if (rc) {
 			msm_dp_hpd_unplug_handle_guarded(priv);
@@ -905,7 +921,8 @@ enum drm_connector_status msm_dp_bridge_detect(struct drm_bridge *bridge,
 		}
 	}
 
-	return priv->plugged_connected ? connector_status_connected : connector_status_disconnected;
+	return priv->plugged == PLUGGED_STATE_LINK_READY ?
+	       connector_status_connected : connector_status_disconnected;
 }
 
 static void msm_dp_display_plugged_retry_work_fn(struct work_struct *work)
@@ -1393,6 +1410,9 @@ void msm_dp_bridge_atomic_enable(struct drm_bridge *drm_bridge,
 		return;
 	}
 
+	if (msm_dp_display->plugged < PLUGGED_STATE_LINK_READY)
+		return;
+
 	if (msm_dp_display->link->sink_count == 0)
 		return;
 
@@ -1419,7 +1439,8 @@ void msm_dp_bridge_atomic_enable(struct drm_bridge *drm_bridge,
 
 end:
 	if (rc) {
-		msm_dp_display->plugged_connected = false;
+		/* reset from LINK_READY */
+		msm_dp_display->plugged = PLUGGED_STATE_PHY_READY;
 		schedule_work(&msm_dp_display->plugged_retry_work);
 	}
 }
-- 
2.55.0

