From e6bee75c70a5b6779f2262e76ffea90684469394 Mon Sep 17 00:00:00 2001
From: JS Deck <jsdeckerido@gmail.com>
Date: Thu, 22 Oct 2026 02:14:39 -0300
Subject: [PATCH 609/609] drm/msm/dp: set audio_enabled early for dp_display

---
 drivers/gpu/drm/msm/dp/dp_audio.c   | 1 -
 drivers/gpu/drm/msm/dp/dp_display.c | 1 +
 2 files changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/msm/dp/dp_audio.c b/drivers/gpu/drm/msm/dp/dp_audio.c
index a21cd28ec4ae..96efe5598257 100644
--- a/drivers/gpu/drm/msm/dp/dp_audio.c
+++ b/drivers/gpu/drm/msm/dp/dp_audio.c
@@ -301,7 +301,6 @@ int msm_dp_audio_prepare(struct drm_bridge *bridge,
 	msm_dp_audio_setup_acr(audio);
 	msm_dp_audio_safe_to_exit_level(audio);
 	msm_dp_audio_enable(audio, true);
-	msm_dp_display->audio_enabled = true;
 
 end:
 	return rc;
diff --git a/drivers/gpu/drm/msm/dp/dp_display.c b/drivers/gpu/drm/msm/dp/dp_display.c
index 17ee40571985..28267a179944 100644
--- a/drivers/gpu/drm/msm/dp/dp_display.c
+++ b/drivers/gpu/drm/msm/dp/dp_display.c
@@ -681,6 +681,7 @@ static int msm_dp_display_post_enable(struct msm_dp *msm_dp_display)
 		dp->audio->lane_count = dp->link->link_params.num_lanes;
 	}
 
+	msm_dp_display->audio_enabled = true;
 	/* signal the connect event late to synchronize video and display */
 	msm_dp_display_handle_plugged_change(msm_dp_display, true);
 
-- 
2.55.0

