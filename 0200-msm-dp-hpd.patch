From 4182412521ad199123a57816f797c6468e639dee Mon Sep 17 00:00:00 2001
From: JS Deck <jsdeckerido@gmail.com>
Date: Mon, 5 Oct 2026 11:22:54 -0300
Subject: [PATCH 09/28] drm/msm/dp: Do not call hpd_notify after bridge_detect

dp_display handles hpd_notify either from its internal hpd or pmic_glink
in case of type-c mux. Calling hpd_notify after detect can race and
sporadically fail hotplug.
---
 drivers/gpu/drm/msm/dp/dp_drm.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/drivers/gpu/drm/msm/dp/dp_drm.c b/drivers/gpu/drm/msm/dp/dp_drm.c
index c1e4147bfef1..5e9ad6430038 100644
--- a/drivers/gpu/drm/msm/dp/dp_drm.c
+++ b/drivers/gpu/drm/msm/dp/dp_drm.c
@@ -322,6 +322,7 @@ int msm_dp_bridge_init(struct msm_dp *msm_dp_display, struct drm_device *dev,
 		bridge->ops =
 			DRM_BRIDGE_OP_DP_AUDIO |
 			DRM_BRIDGE_OP_DETECT |
+			DRM_BRIDGE_OP_DETECT_NO_HPD |
 			DRM_BRIDGE_OP_HPD |
 			DRM_BRIDGE_OP_MODES;
 		bridge->hdmi_audio_dev = &msm_dp_display->pdev->dev;
-- 
