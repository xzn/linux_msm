From 2c4fdcd86223af25f9f38f76d0f493b5217a5ae0 Mon Sep 17 00:00:00 2001
From: JS Deck <jsdeckerido@gmail.com>
Date: Tue, 6 Oct 2026 02:45:16 -0300
Subject: [PATCH 12/28] soc: qcom: pmic_glink: avoid repeated disconnect hpd
 notify

---
 drivers/soc/qcom/pmic_glink_altmode.c | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/drivers/soc/qcom/pmic_glink_altmode.c b/drivers/soc/qcom/pmic_glink_altmode.c
index 465e5d2316a0..147e7aaa3d29 100644
--- a/drivers/soc/qcom/pmic_glink_altmode.c
+++ b/drivers/soc/qcom/pmic_glink_altmode.c
@@ -111,6 +111,8 @@ struct pmic_glink_altmode_port {
 
 	struct work_struct work;
 
+	enum drm_connector_status conn_status;
+
 	struct auxiliary_device *bridge;
 
 	enum typec_orientation orientation;
@@ -346,6 +348,17 @@ static void pmic_glink_altmode_safe(struct pmic_glink_altmode *altmode,
 		dev_err(altmode->dev, "failed to setup retimer to USB: %d\n", ret);
 }
 
+static void pmic_glink_altmode_port_set_conn_status(struct pmic_glink_altmode_port *alt_port,
+						    enum drm_connector_status conn_status)
+{
+	/* Avoid repeated disconnect notify */
+	if (conn_status == alt_port->conn_status &&
+	    conn_status == connector_status_disconnected)
+		return;
+	alt_port->conn_status = conn_status;
+	drm_aux_hpd_bridge_notify(&alt_port->bridge->dev, conn_status);
+}
+
 static void pmic_glink_altmode_worker(struct work_struct *work)
 {
 	struct pmic_glink_altmode_port *alt_port = work_to_altmode_port(work);
@@ -374,7 +387,7 @@ static void pmic_glink_altmode_worker(struct work_struct *work)
 		else
 			conn_status = connector_status_disconnected;
 
-		drm_aux_hpd_bridge_notify(&alt_port->bridge->dev, conn_status);
+		pmic_glink_altmode_port_set_conn_status(alt_port, conn_status);
 	} else if (alt_port->mux_ctrl == MUX_CTRL_STATE_TUNNELING) {
 		if (alt_port->svid == USB_TYPEC_TBT_SID)
 			pmic_glink_altmode_enable_tbt(altmode, alt_port);
-- 
