 }
 
 bool msm_dp_wide_bus_available(const struct msm_dp *msm_dp_display)
@@ -1430,6 +1433,55 @@ bool msm_dp_wide_bus_available(const struct msm_dp *msm_dp_display)
 	return dp->wide_bus_supported;
 }
 
+bool msm_dp_get_mode_dsc(struct msm_dp *msm_dp_display,
+			 const struct drm_display_mode *mode)
+{
+	const u32 num_components = 3, default_bpp = 24;
+	struct msm_dp_display_private *dp;
+	struct msm_dp_panel_bpp mode_bpp = { 0 };
+	bool is_yuv_420;
+
+	dp = container_of(msm_dp_display, struct msm_dp_display_private, msm_dp_display);
+
+	if (!dp->panel->dsc_cap.supported)
+		return false;
+
+	mode_bpp.bpp = msm_dp_display->connector->display_info.bpc * num_components;
+	if (!mode_bpp.bpp)
+		mode_bpp.bpp = default_bpp;
+
+	is_yuv_420 = drm_mode_is_420_only(&msm_dp_display->connector->display_info, mode);
+	if (is_yuv_420)
+		return false;
+
+	mode_bpp = msm_dp_panel_get_mode_bpp(dp->panel, mode_bpp.bpp, mode->clock,
+					     !is_yuv_420, false);
+	return !!mode_bpp.dsc_bpp;
+}
+
+void msm_dp_set_dsc_enable(struct msm_dp *msm_dp_display, int num_dsc)
+{
+	struct msm_dp_display_private *dp;
+
+	dp = container_of(msm_dp_display, struct msm_dp_display_private, msm_dp_display);
+
+	dp->panel->dsc_cap.enabled = num_dsc > 0;
+	dp->panel->dsc_cap.num_dsc = num_dsc;
+	dp->panel->fec_cap.enabled = dp->panel->dsc_cap.enabled;
+}
+
+struct drm_dsc_config *msm_dp_get_dsc_config(struct msm_dp *msm_dp_display)
+{
+	struct msm_dp_display_private *dp;
+
+	dp = container_of(msm_dp_display, struct msm_dp_display_private, msm_dp_display);
+
+	if (dp->panel->dsc_cap.enabled)
+		return &dp->panel->msm_dp_mode.drm_dsc;
+
+	return NULL;
+}
+
 u32 msm_dp_dsc_get_extra_width(const struct msm_dp *msm_dp_display)
 {
 	struct msm_dp_display_private *dp;
