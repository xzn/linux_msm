diff --git a/drivers/gpu/drm/msm/dp/dp_panel.c b/drivers/gpu/drm/msm/dp/dp_panel.c
index d0017aff222b..8307790ee290 100644
--- a/drivers/gpu/drm/msm/dp/dp_panel.c
+++ b/drivers/gpu/drm/msm/dp/dp_panel.c
@@ -11,6 +11,7 @@
 #include <drm/drm_edid.h>
 #include <drm/drm_of.h>
 #include <drm/drm_print.h>
+#include <drm/drm_fixed.h>
 
 #include <linux/io.h>
 #include <linux/types.h>
@@ -31,6 +32,33 @@ struct msm_dp_panel_private {
 	bool panel_on;
 };
 
+#define MSM_DP_MIN_DSC_SRC_BPP 24
+
+/* sorted by dsc_bpp */
+static const struct msm_dp_dto msm_dp_dto_params[] = {
+	{30, 15, 5, 8},
+	{24, 12, 1, 2},
+	{30, 10, 5, 12},
+	{30, 8, 1, 3},
+	{24, 8, 1, 3},
+};
+
+static int msm_dp_panel_get_dto_params(u8 bpp, u8 dsc_bpp, u8 *num, u8 *denom)
+{
+	int i;
+	for (i = 0; i < ARRAY_SIZE(msm_dp_dto_params); i++) {
+		if (msm_dp_dto_params[i].bpp == bpp && msm_dp_dto_params[i].dsc_bpp == dsc_bpp) {
+			*num = msm_dp_dto_params[i].dto_n;
+			*denom = msm_dp_dto_params[i].dto_d;
+			return 0;
+		}
+	}
+	DRM_ERROR("dto params not found for bpp=%d dsc_bpp=%d\n", bpp, dsc_bpp);
+	*num = 0;
+	*denom = 1;
+	return -EINVAL;
+}
+
 u32 msm_dp_stream_reg(enum msm_dp_stream_id id, u32 reg)
 {
 	bool is_s1 = (id == DP_STREAM_1);
@@ -306,25 +334,93 @@ static int msm_dp_panel_read_dpcd(struct msm_dp_panel *msm_dp_panel)
 	return rc;
 }
 
-static u32 msm_dp_panel_get_supported_bpp(struct msm_dp_panel *msm_dp_panel,
-		u32 mode_edid_bpp, u32 mode_pclk_khz)
+static u8 msm_dp_panel_get_supported_bpp_no_dsc(u8 mode_edid_bpp,
+		u32 mode_pclk_khz, u32 data_rate_khz)
 {
-	const struct msm_dp_link_info *link_info;
-	const u32 max_supported_bpp = 30, min_supported_bpp = 18;
-	u32 bpp, data_rate_khz;
+	const u8 max_supported_bpp = 30, min_supported_bpp = 18;
+	u8 bpp = min(mode_edid_bpp, max_supported_bpp);
+
+	for (; bpp >= min_supported_bpp; bpp -= 6)
+		if (mode_pclk_khz * bpp <= data_rate_khz)
+			return bpp;
+
+	return 0;
+}
+
+static struct msm_dp_panel_bpp msm_dp_panel_get_supported_bpp_dsc(struct msm_dp_panel *msm_dp_panel,
+		u8 mode_edid_bpp, u32 mode_pclk_khz, u32 data_rate_khz)
+{
+	const u8 max_supported_bpp = min(mode_edid_bpp, 30);
+	const u8 num_components = 3;
+	int i, j;
+	struct msm_dp_panel_bpp mode_bpp = { 0 };
+
+	for (j = 0; j < ARRAY_SIZE(msm_dp_dto_params); j++) {
+		for (i = 0; i < ARRAY_SIZE(msm_dp_panel->dsc_cap.bpc); i++) {
+			if (msm_dp_panel->dsc_cap.bpc[i]) {
+				u8 bpp = msm_dp_panel->dsc_cap.bpc[i] * num_components;
+
+				if (bpp != msm_dp_dto_params[j].bpp)
+					continue;
+
+				if (bpp > max_supported_bpp)
+					continue;
+
+				if (mode_pclk_khz * msm_dp_dto_params[j].dsc_bpp <= data_rate_khz) {
+					mode_bpp.bpp = bpp;
+					mode_bpp.dsc_bpp = msm_dp_dto_params[j].dsc_bpp;
+					return mode_bpp;
+				}
+			}
+		}
+	}
+
+	return mode_bpp;
+}
 
-	bpp = min(mode_edid_bpp, max_supported_bpp);
+static u32 msm_dp_panel_calc_link_rate(struct msm_dp_panel *msm_dp_panel,
+		bool fec_en)
+{
+	const struct msm_dp_link_info *link_info;
+	s64 rate_fp;
+	s64 fec_overhead_fp;
+	u32 data_rate_khz;
 
 	link_info = &msm_dp_panel->link_info;
 	data_rate_khz = link_info->num_lanes * link_info->rate * 8;
 
-	do {
-		if (mode_pclk_khz * bpp <= data_rate_khz)
-			return bpp;
-		bpp -= 6;
-	} while (bpp > min_supported_bpp);
+	if (fec_en) {
+		fec_overhead_fp = drm_fixp_from_fraction(97582, 100000);
+
+		rate_fp = drm_int2fixp(data_rate_khz);
+		rate_fp = drm_fixp_mul(rate_fp, fec_overhead_fp);
+		data_rate_khz = drm_fixp2int(rate_fp);
+	}
+
+	return data_rate_khz;
+}
+
+static struct msm_dp_panel_bpp msm_dp_panel_get_supported_bpp(struct msm_dp_panel *msm_dp_panel,
+		u32 mode_edid_bpp, u32 mode_pclk_khz, bool dsc_avail, bool dsc_required)
+{
+	struct msm_dp_panel_bpp bpp = { 0 }, dsc_bpp = { 0 };
+
+	if (!dsc_required)
+		bpp.bpp = msm_dp_panel_get_supported_bpp_no_dsc(mode_edid_bpp, mode_pclk_khz,
+				msm_dp_panel_calc_link_rate(msm_dp_panel, false));
+
+	if (!msm_dp_panel->dsc_cap.supported)
+		dsc_avail = false;
 
-	return min_supported_bpp;
+	if (bpp.bpp < MSM_DP_MIN_DSC_SRC_BPP && dsc_avail) {
+		dsc_bpp = msm_dp_panel_get_supported_bpp_dsc(msm_dp_panel, mode_edid_bpp, mode_pclk_khz,
+				msm_dp_panel_calc_link_rate(msm_dp_panel, true));
+
+		if (dsc_bpp.bpp)
+			return dsc_bpp;
+	}
+
+	return bpp;
 }
 
 static void msm_dp_panel_read_sink_fec_caps(struct msm_dp_panel_private *panel)
@@ -446,25 +542,25 @@ int msm_dp_panel_read_link_caps(struct msm_dp_panel *msm_dp_panel,
 	return rc;
 }
 
-u32 msm_dp_panel_get_mode_bpp(struct msm_dp_panel *msm_dp_panel,
-		u32 mode_edid_bpp, u32 mode_pclk_khz)
+struct msm_dp_panel_bpp msm_dp_panel_get_mode_bpp(struct msm_dp_panel *msm_dp_panel, u32 mode_max_bpp,
+						  u32 mode_pclk_khz, bool dsc_avail, bool dsc_required)
 {
 	struct msm_dp_panel_private *panel;
-	u32 bpp;
+	struct msm_dp_panel_bpp bpp = { 0 };
 
-	if (!msm_dp_panel || !mode_edid_bpp || !mode_pclk_khz) {
+	if (!msm_dp_panel || !mode_max_bpp || !mode_pclk_khz) {
 		DRM_ERROR("invalid input\n");
-		return 0;
+		return bpp;
 	}
 
 	panel = container_of(msm_dp_panel, struct msm_dp_panel_private, msm_dp_panel);
 
 	if (msm_dp_panel->video_test)
-		bpp = msm_dp_link_bit_depth_to_bpp(
+		bpp.bpp = msm_dp_link_bit_depth_to_bpp(
 				panel->link->test_video.test_bit_depth);
 	else
-		bpp = msm_dp_panel_get_supported_bpp(msm_dp_panel, mode_edid_bpp,
-				mode_pclk_khz);
+		bpp = msm_dp_panel_get_supported_bpp(msm_dp_panel, mode_max_bpp,
+				mode_pclk_khz, dsc_avail, dsc_required);
 
 	return bpp;
 }
@@ -725,7 +821,7 @@ static int msm_dp_panel_setup_vsc_sdp_yuv_420(struct msm_dp_panel *msm_dp_panel)
 	vsc_sdp_data.colorimetry = DP_COLORIMETRY_DEFAULT;
 
 	/* VSC SDP Payload for DB17 */
-	vsc_sdp_data.bpc = msm_dp_mode->bpp / 3;
+	vsc_sdp_data.bpc = msm_dp_mode->bpp.bpp / 3;
 	vsc_sdp_data.dynamic_range = DP_DYNAMIC_RANGE_CTA;
 
 	/* VSC SDP Payload for DB18 */
@@ -829,7 +925,8 @@ int msm_dp_panel_init_panel_info(struct msm_dp_panel *msm_dp_panel,
 	panel = container_of(msm_dp_panel, struct msm_dp_panel_private, msm_dp_panel);
 
 	drm_mode_copy(&msm_dp_panel->msm_dp_mode.drm_mode, adjusted_mode);
-	msm_dp_panel->msm_dp_mode.bpp = bpp;
+	msm_dp_panel->msm_dp_mode.bpp.bpp = bpp;
+	msm_dp_panel->msm_dp_mode.bpp.dsc_bpp = 0;
 	msm_dp_panel->msm_dp_mode.v_active_low =
 		!!(adjusted_mode->flags & DRM_MODE_FLAG_NVSYNC);
 	msm_dp_panel->msm_dp_mode.h_active_low =
@@ -859,13 +956,15 @@ int msm_dp_panel_init_panel_info(struct msm_dp_panel *msm_dp_panel,
 			drm_mode->vsync_end - drm_mode->vsync_start);
 	drm_dbg_dp(panel->drm_dev, "pixel clock (KHz)=(%d)\n",
 				drm_mode->clock);
-	drm_dbg_dp(panel->drm_dev, "bpp = %d\n", msm_dp_panel->msm_dp_mode.bpp);
+	drm_dbg_dp(panel->drm_dev, "bpp = %d\n", msm_dp_panel->msm_dp_mode.bpp.bpp);
 
-	msm_dp_panel->msm_dp_mode.bpp = msm_dp_panel_get_mode_bpp(msm_dp_panel, msm_dp_panel->msm_dp_mode.bpp,
