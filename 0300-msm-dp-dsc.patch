-				drm_fixp_div(tu->hbp_relative_to_pclk_fp, 2);
-	}
-
-	if (tu->pixelEnc == 422) {
-		switch (tu->bpp) {
-		case 24:
-			tu->bpp = 16;
-			tu->bpc = 8;
-			break;
-		case 30:
-			tu->bpp = 20;
