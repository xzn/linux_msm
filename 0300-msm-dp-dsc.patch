-	tu->hbp_relative_to_pclk_fp = drm_fixp_from_fraction(in->hporch, 1);
-
-	if (tu->pixelEnc == 420) {
-		temp1_fp = drm_fixp_from_fraction(2, 1);
-		tu->pclk_fp = drm_fixp_div(tu->pclk_fp, temp1_fp);
