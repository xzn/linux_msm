 bool msm_dsi_is_master_dsi(struct msm_dsi *msm_dsi);
 bool msm_dsi_wide_bus_enabled(struct msm_dsi *msm_dsi);
 struct drm_dsc_config *msm_dsi_get_dsc_config(struct msm_dsi *msm_dsi);
+bool msm_dsi_get_mode_dsc(struct msm_dsi *msm_dsi, const struct drm_display_mode *mode);
 const char *msm_dsi_get_te_source(struct msm_dsi *msm_dsi);
 #else
 static inline void __init msm_dsi_register(void)
@@ -341,6 +342,11 @@ static inline struct drm_dsc_config *msm_dsi_get_dsc_config(struct msm_dsi *msm_
 	return NULL;
 }
 
+static inline bool msm_dsi_get_mode_dsc(struct msm_dsi *msm_dsi, const struct drm_display_mode *mode)
