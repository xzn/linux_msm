+static void msm_dp_ctrl_sink_fec_enable(struct msm_dp_ctrl_private *ctrl,
+					bool enable)
+{
+	int rlen;
+
+	rlen = drm_dp_dpcd_writeb(ctrl->aux, DP_FEC_CONFIGURATION,
