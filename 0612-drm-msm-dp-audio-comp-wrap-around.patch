From 6cf0b62556e7782477028d8acb73605769f088dd Mon Sep 17 00:00:00 2001
From: JS Deck <jsdeckerido@gmail.com>
Date: Thu, 22 Oct 2026 13:41:01 -0300
Subject: [PATCH 612/612] drm/msm/dp: audio comp wrap-around

---
 drivers/gpu/drm/msm/dp/dp_audio.c   |  10 +-
 drivers/gpu/drm/msm/dp/dp_ctrl.c    |   3 -
 drivers/gpu/drm/msm/dp/dp_display.c | 145 ++++++++++++++++++++--------
 drivers/gpu/drm/msm/dp/dp_display.h |   3 +-
 4 files changed, 116 insertions(+), 45 deletions(-)

diff --git a/drivers/gpu/drm/msm/dp/dp_audio.c b/drivers/gpu/drm/msm/dp/dp_audio.c
index 96efe5598257..1472a14307c6 100644
--- a/drivers/gpu/drm/msm/dp/dp_audio.c
+++ b/drivers/gpu/drm/msm/dp/dp_audio.c
@@ -284,10 +284,8 @@ int msm_dp_audio_prepare(struct drm_bridge *bridge,
 	 * such cases check for connection status and bail out if not
 	 * connected.
 	 */
-	if (!msm_dp_display->power_on) {
-		rc = -EINVAL;
+	if (!msm_dp_display_start(msm_dp_display))
 		goto end;
-	}
 
 	audio = msm_dp_audio_get_data(msm_dp_display);
 	if (IS_ERR(audio)) {
@@ -301,8 +299,10 @@ int msm_dp_audio_prepare(struct drm_bridge *bridge,
 	msm_dp_audio_setup_acr(audio);
 	msm_dp_audio_safe_to_exit_level(audio);
 	msm_dp_audio_enable(audio, true);
+	msm_dp_display->audio_enabled = true;
 
 end:
+	msm_dp_display_end(msm_dp_display);
 	return rc;
 }
 
@@ -314,6 +314,8 @@ void msm_dp_audio_shutdown(struct drm_bridge *bridge,
 
 	msm_dp_display = to_dp_bridge(bridge)->msm_dp_display;
 
+	msm_dp_display_start(msm_dp_display);
+
 	audio = msm_dp_audio_get_data(msm_dp_display);
 	if (IS_ERR(audio)) {
 		DRM_ERROR("failed to get audio data\n");
@@ -337,6 +339,8 @@ void msm_dp_audio_shutdown(struct drm_bridge *bridge,
 end:
 	/* signal the dp display to safely shutdown clocks */
 	msm_dp_display_signal_audio(msm_dp_display);
+
+	msm_dp_display_end(msm_dp_display);
 }
 
 struct msm_dp_audio *msm_dp_audio_get(struct platform_device *pdev,
diff --git a/drivers/gpu/drm/msm/dp/dp_ctrl.c b/drivers/gpu/drm/msm/dp/dp_ctrl.c
index a9c1192a699a..1ba5380c1c21 100644
--- a/drivers/gpu/drm/msm/dp/dp_ctrl.c
+++ b/drivers/gpu/drm/msm/dp/dp_ctrl.c
@@ -1636,7 +1636,6 @@ int msm_dp_ctrl_on_link(struct msm_dp_ctrl *msm_dp_ctrl)
 {
 	int rc = 0;
 	struct msm_dp_ctrl_private *ctrl;
-	u32 rate;
 	int link_train_max_retries = 5;
 	u8 link_status[DP_LINK_STATUS_SIZE];
 	unsigned int training_step;
@@ -1646,8 +1645,6 @@ int msm_dp_ctrl_on_link(struct msm_dp_ctrl *msm_dp_ctrl)
 
 	ctrl = container_of(msm_dp_ctrl, struct msm_dp_ctrl_private, msm_dp_ctrl);
 
-	rate = ctrl->panel->link_info.rate;
-
 	msm_dp_ctrl_core_clk_enable(&ctrl->msm_dp_ctrl);
 
 	if (ctrl->link->sink_request & DP_TEST_LINK_PHY_TEST_PATTERN) {
diff --git a/drivers/gpu/drm/msm/dp/dp_display.c b/drivers/gpu/drm/msm/dp/dp_display.c
index e149190441de..1f065637af7d 100644
--- a/drivers/gpu/drm/msm/dp/dp_display.c
+++ b/drivers/gpu/drm/msm/dp/dp_display.c
@@ -57,6 +57,12 @@ enum plugged_pending {
 	PLUGGED_PENDING_CONNECT,
 };
 
+enum power_state {
+	POWER_STATE_OFF,
+	POWER_STATE_OFF_PENDING,
+	POWER_STATE_ON,
+};
+
 struct msm_dp_display_private {
 	int irq;
 
@@ -83,6 +89,9 @@ struct msm_dp_display_private {
 
 	/* wait for audio signaling */
 	struct completion audio_comp;
+	struct work_struct audio_work_tail;
+	struct completion display_disable_comp;
+	enum power_state power;
 
 	/* pmic_glink device for mux notify if present */
 	struct device_link *pmic_glink;
@@ -204,6 +213,26 @@ static struct msm_dp_display_private *dev_get_dp_display_private(struct device *
 	return container_of(dp, struct msm_dp_display_private, msm_dp_display);
 }
 
+bool msm_dp_display_start(struct msm_dp *msm_dp_display)
+{
+	struct msm_dp_display_private *dp;
+
+	dp = container_of(msm_dp_display, struct msm_dp_display_private, msm_dp_display);
+
+	mutex_lock(&dp->plugged_lock);
+
+	return dp->power == POWER_STATE_ON;
+}
+
+void msm_dp_display_end(struct msm_dp *msm_dp_display)
+{
+	struct msm_dp_display_private *dp;
+
+	dp = container_of(msm_dp_display, struct msm_dp_display_private, msm_dp_display);
+
+	mutex_unlock(&dp->plugged_lock);
+}
+
 void msm_dp_display_signal_audio(struct msm_dp *msm_dp_display)
 {
 	struct msm_dp_display_private *dp;
@@ -473,7 +502,6 @@ static void msm_dp_display_handle_plugged_change(struct msm_dp *msm_dp_display,
 	/* notify audio subsystem only if sink supports audio */
 	if (dp->audio_supported) {
 		DRM_INFO("msm-dp: notifying hdmi audio plugged=%d\n", plugged);
-
 		drm_connector_hdmi_audio_plugged_notify(msm_dp_display->connector,
 							plugged);
 	}
@@ -498,7 +526,7 @@ static int msm_dp_hpd_unplug_handle_guarded(struct msm_dp_display_private *dp)
 	if (!dp->msm_dp_display.is_edp)
 		msm_dp_panel_unplugged(dp->panel, dp->msm_dp_display.connector);
 
-	if (!dp->msm_dp_display.power_on) {
+	if (dp->power == POWER_STATE_OFF) {
 		/* triggered by irq_hdp with sink_count = 0 */
 		msm_dp_ctrl_off(dp->ctrl);
 		msm_dp_display_host_phy_exit(dp);
@@ -652,22 +680,21 @@ static int msm_dp_init_sub_modules(struct msm_dp_display_private *dp)
 static int msm_dp_display_enable(struct msm_dp_display_private *dp)
 {
 	int rc = 0;
-	struct msm_dp *msm_dp_display = &dp->msm_dp_display;
 
 	drm_dbg_dp(dp->drm_dev, "sink_count=%d\n", dp->link->sink_count);
-	if (msm_dp_display->power_on) {
+	if (dp->power == POWER_STATE_ON) {
 		drm_dbg_dp(dp->drm_dev, "Link already setup, return\n");
 		return 0;
 	}
 
 	rc = msm_dp_ctrl_on_stream(dp->ctrl, true);
 	if (!rc)
-		msm_dp_display->power_on = true;
+		dp->power = POWER_STATE_ON;
 
 	return rc;
 }
 
-static int msm_dp_display_post_enable(struct msm_dp *msm_dp_display)
+static void msm_dp_display_post_enable(struct msm_dp *msm_dp_display)
 {
 	struct msm_dp_display_private *dp;
 	u32 rate;
@@ -681,34 +708,15 @@ static int msm_dp_display_post_enable(struct msm_dp *msm_dp_display)
 		dp->audio->lane_count = dp->link->link_params.num_lanes;
 	}
 
-	msm_dp_display->audio_enabled = true;
 	/* signal the connect event late to synchronize video and display */
 	msm_dp_display_handle_plugged_change(msm_dp_display, true);
 
 	if (msm_dp_display->psr_supported)
 		msm_dp_ctrl_config_psr(dp->ctrl);
-
-	return 0;
 }
 
-static int msm_dp_display_disable(struct msm_dp_display_private *dp)
+static void msm_dp_display_disable_tail(struct msm_dp_display_private *dp)
 {
-	struct msm_dp *msm_dp_display = &dp->msm_dp_display;
-
-	if (!msm_dp_display->power_on)
-		return 0;
-
-	if (msm_dp_display->audio_enabled) {
-		reinit_completion(&dp->audio_comp);
-
-		/* signal the disconnect event */
-		msm_dp_display_handle_plugged_change(msm_dp_display, false);
-
-		if (!wait_for_completion_timeout(&dp->audio_comp,
-				HZ * 5))
-			DRM_ERROR("audio comp timeout\n");
-	}
-
 	if (dp->plugged_pending > PLUGGED_PENDING_NONE) {
 		/*
 		 * unplugged interrupt
@@ -729,7 +737,7 @@ static int msm_dp_display_disable(struct msm_dp_display_private *dp)
 		msm_dp_ctrl_off_link_stream(dp->ctrl);
 	}
 
-	msm_dp_display->power_on = false;
+	dp->power = POWER_STATE_OFF;
 
 	if (dp->plugged_pending == PLUGGED_PENDING_CONNECT) {
 		/* reset before calling plug_handle */
@@ -744,7 +752,60 @@ static int msm_dp_display_disable(struct msm_dp_display_private *dp)
 		dp->plugged_pending = PLUGGED_PENDING_NONE;
 
 	drm_dbg_dp(dp->drm_dev, "sink count: %d\n", dp->link->sink_count);
-	return 0;
+
+	drm_dbg_dp(dp->drm_dev, "type=%d Done\n", dp->msm_dp_display.connector_type);
+
+	complete_all(&dp->display_disable_comp);
+
+	pm_runtime_put_sync(&dp->msm_dp_display.pdev->dev);
+}
+
+static void msm_dp_display_audio_disable(struct msm_dp_display_private *dp)
+{
+	struct msm_dp *msm_dp_display = &dp->msm_dp_display;
+
+	if (msm_dp_display->audio_enabled) {
+		reinit_completion(&dp->audio_comp);
+
+		/* signal the disconnect event */
+		msm_dp_display_handle_plugged_change(msm_dp_display, false);
+
+		schedule_work(&dp->audio_work_tail);
+	} else
+		msm_dp_display_disable_tail(dp);
+}
+
+static void msm_dp_display_audio_work_tail_fn(struct work_struct *work)
+{
+	struct msm_dp_display_private *msm_dp_display = container_of(work,
+								     typeof(*msm_dp_display),
+								     audio_work_tail);
+
+	bool timed_out = !wait_for_completion_timeout(&msm_dp_display->audio_comp,
+			HZ * 4);
+
+	guard(mutex)(&msm_dp_display->plugged_lock);
+
+	if (timed_out) {
+		DRM_ERROR("audio comp timeout\n");
+		msm_dp_display_disable_tail(msm_dp_display);
+	} else
+		msm_dp_display_audio_disable(msm_dp_display);
+}
+
+static void msm_dp_display_disable(struct msm_dp_display_private *dp)
+{
+	if (dp->power < POWER_STATE_ON)
+		return;
+
+	dp->power = POWER_STATE_OFF_PENDING;
+
+	if (pm_runtime_resume_and_get(&dp->msm_dp_display.pdev->dev)) {
+		DRM_ERROR("failed to pm_runtime_resume\n");
+		return;
+	}
+	reinit_completion(&dp->display_disable_comp);
+	msm_dp_display_audio_disable(dp);
 }
 
 /**
@@ -894,7 +955,7 @@ void msm_dp_snapshot(struct msm_disp_state *disp_state, struct msm_dp *dp)
 	 * power_on status before dumping DP registers to avoid crash due
 	 * to unclocked access
 	 */
-	if (!dp->power_on)
+	if (msm_dp_display->power < POWER_STATE_ON)
 		return;
 
 	msm_disp_snapshot_add_block(disp_state, msm_dp_display->ahb_len,
@@ -931,6 +992,8 @@ int msm_dp_bridge_atomic_check(struct drm_bridge *bridge,
 	msm_dp_display = to_dp_bridge(bridge)->msm_dp_display;
 	dp = container_of(msm_dp_display, struct msm_dp_display_private, msm_dp_display);
 
+	guard(mutex)(&dp->plugged_lock);
+
 	/*
 	drm_dbg_dp(msm_dp_display->drm_dev, "link_ready = %s\n",
 		str_true_false(dp->plugged == PLUGGED_STATE_LINK_READY));
@@ -1279,6 +1342,10 @@ static int msm_dp_display_probe(struct platform_device *pdev)
 	dp->msm_dp_display.msm_dp_audio = dp->audio;
 
 	init_completion(&dp->audio_comp);
+	INIT_WORK(&dp->audio_work_tail,
+		  msm_dp_display_audio_work_tail_fn);
+	init_completion(&dp->display_disable_comp);
+	complete_all(&dp->display_disable_comp);
 
 	platform_set_drvdata(pdev, &dp->msm_dp_display);
 
@@ -1607,6 +1674,10 @@ void msm_dp_bridge_atomic_enable(struct drm_bridge *drm_bridge,
 		return;
 	}
 
+	if (!wait_for_completion_timeout(&msm_dp_display->display_disable_comp,
+			HZ * 6))
+		return;
+
 	guard(mutex)(&msm_dp_display->plugged_lock);
 
 	if (!msm_dp_display->panel->msm_dp_mode.drm_mode.clock) {
@@ -1643,12 +1714,7 @@ void msm_dp_bridge_atomic_enable(struct drm_bridge *drm_bridge,
 	if (rc)
 		goto end;
 
-	rc = msm_dp_display_post_enable(dp);
-	if (rc) {
-		DRM_ERROR("DP display post enable failed, rc=%d\n", rc);
-		msm_dp_display_disable(msm_dp_display);
-		goto end;
-	}
+	msm_dp_display_post_enable(dp);
 
 	drm_dbg_dp(dp->drm_dev, "type=%d Done\n", dp->connector_type);
 
@@ -1669,6 +1735,7 @@ void msm_dp_bridge_atomic_disable(struct drm_bridge *drm_bridge,
 
 	msm_dp_display = container_of(dp, struct msm_dp_display_private, msm_dp_display);
 
+	guard(mutex)(&msm_dp_display->plugged_lock);
 	/*
 	 * If .atomic_enable() bailed out - link training failure is the common
 	 * case - the mainlink was never brought up and ->power_on stayed false.
@@ -1680,7 +1747,7 @@ void msm_dp_bridge_atomic_disable(struct drm_bridge *drm_bridge,
 	 * TrustZone-level SOCCP/ADSP force-stop and a silent SoC reset.
 	 * There is nothing to push idle, so leave it alone.
 	 */
-	if (!dp->power_on)
+	if (msm_dp_display->power < POWER_STATE_ON)
 		return;
 
 	msm_dp_ctrl_push_idle(msm_dp_display->ctrl);
@@ -1702,8 +1769,6 @@ void msm_dp_bridge_atomic_post_disable(struct drm_bridge *drm_bridge,
 
 	msm_dp_display_disable(msm_dp_display);
 
-	drm_dbg_dp(dp->drm_dev, "type=%d Done\n", dp->connector_type);
-
 	pm_runtime_put_sync(&dp->pdev->dev);
 }
 
@@ -1761,6 +1826,8 @@ void msm_dp_bridge_hpd_enable(struct drm_bridge *bridge)
 	struct msm_dp *msm_dp_display = msm_dp_bridge->msm_dp_display;
 	struct msm_dp_display_private *dp = container_of(msm_dp_display, struct msm_dp_display_private, msm_dp_display);
 
+	guard(mutex)(&dp->plugged_lock);
+
 	/*
 	 * this is for external DP with hpd irq enabled case,
 	 * step-1: msm_dp_pm_runtime_resume() enable dp host only
@@ -1784,6 +1851,8 @@ void msm_dp_bridge_hpd_disable(struct drm_bridge *bridge)
 	struct msm_dp *msm_dp_display = msm_dp_bridge->msm_dp_display;
 	struct msm_dp_display_private *dp = container_of(msm_dp_display, struct msm_dp_display_private, msm_dp_display);
 
+	guard(mutex)(&dp->plugged_lock);
+
 	msm_dp_aux_hpd_intr_disable(dp->aux);
 	msm_dp_aux_hpd_disable(dp->aux);
 
diff --git a/drivers/gpu/drm/msm/dp/dp_display.h b/drivers/gpu/drm/msm/dp/dp_display.h
index a317a79ab81b..05073019dc52 100644
--- a/drivers/gpu/drm/msm/dp/dp_display.h
+++ b/drivers/gpu/drm/msm/dp/dp_display.h
@@ -18,7 +18,6 @@ struct msm_dp {
 	struct drm_bridge *next_bridge;
 	struct drm_bridge *bridge;
 	bool audio_enabled;
-	bool power_on;
 	unsigned int connector_type;
 	bool is_edp;
 
@@ -28,6 +27,8 @@ struct msm_dp {
 
 bool msm_dp_display_check_video_test(struct msm_dp *msm_dp_display);
 int msm_dp_display_get_test_bpp(struct msm_dp *msm_dp_display);
+bool msm_dp_display_start(struct msm_dp *msm_dp_display);
+void msm_dp_display_end(struct msm_dp *msm_dp_display);
 void msm_dp_display_signal_audio(struct msm_dp *msm_dp_display);
 void msm_dp_display_set_psr(struct msm_dp *dp, bool enter);
 void msm_dp_display_debugfs_init(struct msm_dp *msm_dp_display, struct dentry *dentry, bool is_edp);
-- 
