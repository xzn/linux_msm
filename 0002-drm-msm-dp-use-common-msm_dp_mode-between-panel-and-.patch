+						      mode_cfg->dsc,
+						      drm_mode->clock);
+
+	drm_dbg_dp(panel->drm_dev, "updated_bpp=%d fec=%d dsc=%d\n",
+				mode_cfg->bpp,
+				mode_cfg->fec_available,
+				mode_cfg->dsc);
 
