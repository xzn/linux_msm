-	drm_dbg_dp(panel->drm_dev, "updated bpp = %d\n",
-				msm_dp_panel->msm_dp_mode.bpp);
+	drm_dbg_dp(panel->drm_dev, "bpp = %d\n", mode_cfg->bpp);
+
+	*mode_cfg = msm_dp_panel_get_mode_cfg(
