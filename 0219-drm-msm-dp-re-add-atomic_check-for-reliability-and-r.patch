From b78c1a5b92ed171e9d68201de74e04f521c03108 Mon Sep 17 00:00:00 2001
From: JS Deck <jsdeckerido@gmail.com>
Date: Tue, 6 Oct 2026 04:25:09 -0300
Subject: [PATCH 219/219] drm/msm/dp: re-add atomic_check for reliability, and
 re-add check in get_modes

---
 drivers/gpu/drm/msm/dp/dp_display.c | 70 ++++++++++++++++++++++++++---
 drivers/gpu/drm/msm/dp/dp_display.h |  1 -
 drivers/gpu/drm/msm/dp/dp_drm.c     | 28 +-----------
 drivers/gpu/drm/msm/dp/dp_drm.h     |  5 +++
 4 files changed, 70 insertions(+), 34 deletions(-)

diff --git a/drivers/gpu/drm/msm/dp/dp_display.c b/drivers/gpu/drm/msm/dp/dp_display.c
index ba5d6370fe79..3cce49b30104 100644
--- a/drivers/gpu/drm/msm/dp/dp_display.c
+++ b/drivers/gpu/drm/msm/dp/dp_display.c
@@ -839,19 +839,46 @@ enum drm_mode_status msm_dp_bridge_mode_valid(struct drm_bridge *bridge,
 	return MODE_OK;
 }
 
-int msm_dp_display_get_modes(struct msm_dp *dp)
+static int msm_dp_display_get_modes(struct msm_dp_display_private *dp)
 {
-	struct msm_dp_display_private *msm_dp_display;
-
 	if (!dp) {
 		DRM_ERROR("invalid params\n");
 		return 0;
 	}
 
-	msm_dp_display = container_of(dp, struct msm_dp_display_private, msm_dp_display);
+	return msm_dp_panel_get_modes(dp->panel,
+		dp->msm_dp_display.connector);
+}
+
+/**
+ * msm_dp_bridge_get_modes - callback to add drm modes via drm_mode_probed_add()
+ * @bridge: Pointer to drm bridge
+ * @connector: Pointer to drm connector structure
+ * Returns: Number of modes added
+ */
+int msm_dp_bridge_get_modes(struct drm_bridge *bridge, struct drm_connector *connector)
+{
+	int rc = 0;
+	struct msm_dp *msm_dp_display;
+	struct msm_dp_display_private *dp;
+
+	if (!connector)
+		return 0;
+
+	msm_dp_display = to_dp_bridge(bridge)->msm_dp_display;
+	dp = container_of(msm_dp_display, struct msm_dp_display_private, msm_dp_display);
 
-	return msm_dp_panel_get_modes(msm_dp_display->panel,
-		dp->connector);
+	/* pluggable case assumes EDID is read when HPD */
+	if (dp->plugged == PLUGGED_STATE_LINK_READY) {
+		rc = msm_dp_display_get_modes(dp);
+		if (rc <= 0) {
+			DRM_ERROR("failed to get DP sink modes, rc=%d\n", rc);
+			return rc;
+		}
+	} else {
+		drm_dbg_dp(connector->dev, "No sink connected\n");
+	}
+	return rc;
 }
 
 bool msm_dp_display_check_video_test(struct msm_dp *dp)
@@ -917,6 +944,37 @@ void msm_dp_display_set_psr(struct msm_dp *msm_dp_display, bool enter)
 	msm_dp_ctrl_set_psr(dp->ctrl, enter);
 }
 
+int msm_dp_bridge_atomic_check(struct drm_bridge *bridge,
+			       struct drm_bridge_state *bridge_state,
+			       struct drm_crtc_state *crtc_state,
+			       struct drm_connector_state *conn_state)
+{
+	struct msm_dp *msm_dp_display;
+	struct msm_dp_display_private *dp;
+
+	msm_dp_display = to_dp_bridge(bridge)->msm_dp_display;
+	dp = container_of(msm_dp_display, struct msm_dp_display_private, msm_dp_display);
+
+	drm_dbg_dp(msm_dp_display->drm_dev, "link_ready = %s\n",
+		str_true_false(dp->plugged == PLUGGED_STATE_LINK_READY));
+
+	/*
+	 * There is no protection in the DRM framework to check if the display
+	 * pipeline has been already disabled before trying to disable it again.
+	 * Hence if the sink is unplugged, the pipeline gets disabled, but the
+	 * crtc->active is still true. Any attempt to set the mode or manually
+	 * disable this encoder will result in crash.
+	 *
+	 * TODO: add support for telling the DRM subsystem that the pipeline is
+	 * disabled by the hardware and thus all access to it should be forbidden.
+	 * After that this piece of code can be removed.
+	 */
+	if (bridge->ops & DRM_BRIDGE_OP_HPD)
+		return dp->plugged == PLUGGED_STATE_LINK_READY ? 0 : -ENOTCONN;
+
+	return 0;
+}
+
 /**
  * msm_dp_bridge_detect - callback to determine if connector is connected
  *
diff --git a/drivers/gpu/drm/msm/dp/dp_display.h b/drivers/gpu/drm/msm/dp/dp_display.h
index 0b65e16c790d..89230d6890f8 100644
--- a/drivers/gpu/drm/msm/dp/dp_display.h
+++ b/drivers/gpu/drm/msm/dp/dp_display.h
@@ -26,7 +26,6 @@ struct msm_dp {
 	bool psr_supported;
 };
 
-int msm_dp_display_get_modes(struct msm_dp *msm_dp_display);
 bool msm_dp_display_check_video_test(struct msm_dp *msm_dp_display);
 int msm_dp_display_get_test_bpp(struct msm_dp *msm_dp_display);
 void msm_dp_display_signal_audio_start(struct msm_dp *msm_dp_display);
