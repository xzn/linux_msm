From 9f1946da044b55cdff227066d95ea7f294bd449b Mon Sep 17 00:00:00 2001
From: JS Deck <jsdeckerido@gmail.com>
Date: Mon, 5 Oct 2026 12:27:47 -0300
Subject: [PATCH 211/219] drm/msm/dp: prevent repeated phy_power_on of dp phy
 in case of error

---
 drivers/gpu/drm/msm/dp/dp_ctrl.c | 12 ++++++++----
 1 file changed, 8 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/msm/dp/dp_ctrl.c b/drivers/gpu/drm/msm/dp/dp_ctrl.c
index 86ef8c89ad44..d2409f79a809 100644
--- a/drivers/gpu/drm/msm/dp/dp_ctrl.c
+++ b/drivers/gpu/drm/msm/dp/dp_ctrl.c
@@ -1805,8 +1805,10 @@ static int msm_dp_ctrl_enable_mainlink_clocks(struct msm_dp_ctrl_private *ctrl)
 
 	dev_pm_opp_set_rate(ctrl->dev, ctrl->link->link_params.rate * 1000);
 	ret = msm_dp_ctrl_link_clk_enable(&ctrl->msm_dp_ctrl);
-	if (ret)
+	if (ret) {
 		DRM_ERROR("Unable to start link clocks. ret=%d\n", ret);
+		phy_power_off(phy);
+	}
 
 	drm_dbg_dp(ctrl->drm_dev, "link rate=%d\n", ctrl->link->link_params.rate);
 
@@ -2303,9 +2305,11 @@ int msm_dp_ctrl_on_link(struct msm_dp_ctrl *msm_dp_ctrl)
 		ctrl->link->link_params.rate, ctrl->link->link_params.num_lanes,
 		pixel_rate);
 
-	rc = msm_dp_ctrl_enable_mainlink_clocks(ctrl);
-	if (rc)
-		return rc;
+	if (!ctrl->link_clks_on) { /* link clk is off */
+		rc = msm_dp_ctrl_enable_mainlink_clocks(ctrl);
+		if (rc)
+			return rc;
+	}
 
 	while (--link_train_max_retries) {
 		training_step = DP_TRAINING_NONE;
-- 
2.55.0

