 	struct msm_dp_dsc_cfg *msm_dp_dsc = &msm_dp_mode->msm_dp_dsc;
@@ -1084,7 +1135,11 @@ static int msm_dp_populate_dsc_private_params(struct msm_dp_display_mode *msm_dp
 	u32 slice_per_intf;
