 	if (!drm_dsc->slice_width ||
 			!drm_dsc->slice_height ||
@@ -1098,20 +1153,32 @@ static int msm_dp_populate_dsc_private_params(struct msm_dp_display_mode *msm_dp
 	slice_per_intf = DIV_ROUND_UP(intf_width,
